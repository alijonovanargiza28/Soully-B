{
  "name": "soully-api",
  "version": "1.0.0",
  "description": "Soully flower shop API and administration",
  "main": "src/server.ts",
  "scripts": {
    "start": "ts-node src/server.ts",
    "start:dev": "nodemon --exec ts-node src/server.ts",
    "build": "node scripts/build.cjs",
    "test": "node --test tests/*.test.cjs",
    "check": "tsc --noEmit",
    "start:prod": "node dist/server.js",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,css}\" \"tests/**/*.cjs\" \"scripts/**/*.cjs\" --no-error-on-unmatched-pattern",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,css}\" \"tests/**/*.cjs\" \"scripts/**/*.cjs\" --no-error-on-unmatched-pattern",
    "lint": "eslint src --ext .ts,.tsx --max-warnings 0",
    "test:integration": "node --test tests/integration/*.test.cjs"
  },
  "author": "MIT",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "connect-mongodb-session": "^3.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "ejs": "^3.1.6",
    "express": "^4.17.3",
    "express-session": "^1.17.3",
    "jsonwebtoken": "^8.5.1",
    "mongoose": "^6.2.9",
    "morgan": "^1.10.1",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@types/connect-mongodb-session": "^2.4.8",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.3",
    "@types/express-session": "^1.19.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.1.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "mongodb-memory-server": "^10.4.3",
    "nodemon": "^3.0.2",
    "prettier": "^3.3.3",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.2.2"
  }
}
