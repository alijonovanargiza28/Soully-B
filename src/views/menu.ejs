<!DOCTYPE html>
<html lang="en">
<head>

  <%- include('partials/head', {
    title: 'Menu',
    cssFile: 'menu.css'
  }) %>

</head>

<body>

  <div class="bloom-page">

    <div
      class="bloom-wash"
      aria-hidden="true"
    ></div>


    <!-- ADMIN NAV -->

    <%- include('partials/nav-admin', {
      active: 'menu'
    }) %>


    <!-- MAIN -->

    <main class="bloom-stage">

      <h1 class="bloom-title">
        Flower Menu
      </h1>


      <% if (typeof saved !== "undefined" && saved) { %><p role="status">Product saved successfully.</p><% } %>

      <!-- PRODUCT TABLE -->

      <div class="bloom-table-wrap">

        <table>

          <thead>

            <tr>
              <th>T/r</th>
              <th>Product Name</th>
              <th>Collection</th>
              <th>Size</th>
              <th>Price</th>
              <th>Left Count</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>

          </thead>


          <tbody id="productsBody">

            <% products.forEach(function(p, i){ %>

              <tr>

                <!-- NUMBER -->

                <td>
                  <%= i + 1 %>
                </td>


                <!-- PRODUCT NAME -->

                <td>
                  <%= p.productName %>
                </td>


                <!-- COLLECTION -->

                <td>
                  <%= p.productCollection %>
                </td>


                <!-- SIZE -->

                <td>
                  <%= p.productSize %>
                </td>


                <!-- PRICE -->

                <td>
                  $<%= p.productPrice %>
                </td>


                <!-- LEFT COUNT -->

                <td>
                  <%= p.productLeftCount %>
                </td>


                <!-- STATUS -->

                <td>

                  <select
                    class="bloom-select <%=
                      p.productStatus === 'PROCESS'
                        ? 'active'
                        : ''
                    %>"
                    onchange="
                      updateProductStatus(
                        '<%= p._id %>',
                        this
                      )
                    "
                  >

                    <option
                      value="PAUSE"
                      <%=
                        p.productStatus === 'PAUSE'
                          ? 'selected'
                          : ''
                      %>
                    >
                      PAUSE
                    </option>


                    <option
                      value="PROCESS"
                      <%=
                        p.productStatus === 'PROCESS'
                          ? 'selected'
                          : ''
                      %>
                    >
                      PROCESS
                    </option>


                    <option
                      value="DELETE"
                      <%=
                        p.productStatus === 'DELETE'
                          ? 'selected'
                          : ''
                      %>
                    >
                      DELETE
                    </option>

                  </select>

                </td>

                <td><button type="button" class="bloom-btn-ghost edit-product" data-product="<%= JSON.stringify(p) %>">Edit</button></td>
              </tr>

            <% }) %>

          </tbody>

        </table>

      </div>


      <!-- NEW PRODUCT BUTTON -->

      <div class="bloom-actions">

        <button
          class="bloom-submit"
          id="newProductBtn"
          type="button"
        >
          New Product
        </button>

      </div>


      <div class="bloom-floral-footer"></div>

    </main>

  </div>



  <!-- =========================
       NEW PRODUCT MODAL
  ========================== -->

  <div
    class="bloom-modal-overlay"
    id="modalOverlay"
  >

    <div class="bloom-modal">


      <!-- MODAL HEADER -->

      <div class="bloom-modal-head">

        <h2>
          New Product
        </h2>


        <button
          type="button"
          class="bloom-modal-close"
          id="closeModalBtn"
        >
          &times;
        </button>

      </div>


      <!-- FORM -->

      <form
        id="newProductForm"
        action="/admin/product/create"
        method="POST"
        enctype="multipart/form-data"
      >


        <!-- NAME + COLLECTION -->

        <div class="bloom-row">


          <div class="bloom-field">

            <label for="productName">
              Product Name *
            </label>


            <input
              type="text"
              name="productName"
              id="productName"
              minlength="2" maxlength="100"
              placeholder="Rose Bouquet"
              required
            />

          </div>


          <div class="bloom-field">

            <label for="productCollection">
              Collection *
            </label>


            <select
              name="productCollection"
              id="productCollection"
              required
            >

              <option value="" selected disabled>Select Collection</option>
              <% collections.forEach(function(collection) { %>
                <option value="<%= collection %>"><%= collection.replace(/_/g, ' ') %></option>
              <% }) %>

            </select>

          </div>

        </div>



        <!-- PRICE + LEFT COUNT -->

        <div class="bloom-row">


          <div class="bloom-field">

            <label for="productPrice">
              Price *
            </label>


            <input
              type="number"
              name="productPrice"
              id="productPrice"
              min="0" step="0.01"
              required
            />

          </div>


          <div class="bloom-field">

            <label for="productLeftCount">
              Left Count *
            </label>


            <input
              type="number"
              name="productLeftCount"
              id="productLeftCount"
              min="0" step="1"
              required
            />

          </div>

        </div>



        <!-- SIZE + STATUS -->

        <div class="bloom-row">


          <div class="bloom-field">

            <label for="productSize">
              Size
            </label>


            <select
              name="productSize"
              id="productSize"
            >

              <option
                value="MEDIUM"
                selected
              >
                MEDIUM
              </option>


              <option value="SMALL">
                Small
              </option>


              <option value="LARGE">
                Large
              </option>

            </select>

          </div>


          <div class="bloom-field">

            <label for="productStatus">
              Status
            </label>


            <select
              name="productStatus"
              id="productStatus"
            >

              <option
                value="PAUSE"
                selected
              >
                Pause
              </option>


              <option value="PROCESS">
                Process
              </option>


              <option value="DELETE">
                Delete
              </option>

            </select>

          </div>

        </div>



        <!-- DESCRIPTION -->

        <div
          class="bloom-field bloom-field--full"
        >

          <label for="productDesc">
            Description
          </label>


          <textarea
            name="productDesc"
            id="productDesc" maxlength="2000"
            rows="4"
          ></textarea>

        </div>



        <!-- IMAGES -->

        <div class="bloom-upload">

          <label for="productImages">
            Product Images
          </label>


          <div class="bloom-upload-row">


            <input
              type="file"
              id="productImages"
              name="productImages"
              accept=".jpg,.jpeg,.png"
              multiple
            />


            <button
              type="button"
              id="uploadImagesBtn"
            >
              Upload Images
            </button>

          </div>


          <p class="bloom-hint">
            Only JPG, JPEG and PNG files.
          </p>


          <div
            id="previewGrid"
            class="bloom-preview-grid"
          ></div>

        </div>



        <!-- ERROR -->

        <p
          class="bloom-error"
          id="productErrorMsg"
        ></p>



        <!-- ACTIONS -->

        <div class="bloom-modal-actions">


          <button
            type="button"
            class="bloom-btn-ghost"
            id="cancelModalBtn"
          >
            Cancel
          </button>


          <button
            type="submit"
            class="bloom-submit"
          >
            Save Product
          </button>

        </div>


      </form>

    </div>

  </div>



  <!-- MENU JS -->

  <script src="/js/menu.js"></script>

</body>
</html>
