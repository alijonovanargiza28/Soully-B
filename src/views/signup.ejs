<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', { title: 'Signup', cssFile: 'signup.css' }) %>
</head>
<body>

  <div class="bloom-page">
    <div class="bloom-wash" aria-hidden="true"></div>

    <%- include('partials/nav-admin', { active: 'signup' }) %>

    <main class="bloom-stage">
      <div class="bloom-card">
        <h1 class="bloom-title">Signup</h1>
        <p class="bloom-subtext">Already signed up? <a href="/admin/login">Login</a></p>

        <form id="signupForm" action="/admin/signup" method="POST" enctype="multipart/form-data">
          <div class="bloom-row">
            <div class="bloom-field">
              <label for="brandName">Brand name *</label>
              <input type="text" name="memberNick" id="brandName" placeholder="Username" required />
            </div>
            <div class="bloom-field">
              <label for="phone">Phone *</label>
              <input type="tel" name="memberPhone" id="phone" placeholder="Phone" required />
            </div>
          </div>

          <div class="bloom-row">
            <div class="bloom-field">
              <label for="password">Password *</label>
              <input type="password" name="memberPassword" id="password" placeholder="Password" required />
            </div>
            <div class="bloom-field">
              <label for="repeatPassword">Repeat password *</label>
              <input type="password" name="confirmPassword" id="repeatPassword" placeholder="Repeat password" required />
            </div>
          </div>

          <div class="bloom-upload">
            <label>Member image</label>
            <div class="bloom-upload-row">
              <input type="file" name="memberImage" id="fileInput" accept=".jpg,.jpeg,.png" />
              <button type="button" id="uploadBtn">Upload Image</button>
            </div>
            <p class="bloom-hint">Please upload shop image.<br />Attention only: .jpg, .jpeg, or .png formats allowed!</p>
            <div class="bloom-preview" id="preview"></div>
          </div>

          <% if (typeof error !== 'undefined' && error) { %>
            <p class="bloom-error"><%= error %></p>
          <% } else { %>
            <p class="bloom-error" id="errorMsg"></p>
          <% } %>

          <button type="submit" class="bloom-submit">Signup</button>
        </form>
      </div>
    </main>

    <footer class="bloom-footer">
      <span></span>
    </footer>
  </div>

  <script src="/js/signup.js"></script>
</body>
</html>
