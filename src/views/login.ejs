<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', { title: 'Login', cssFile: 'login.css' }) %>
</head>
<body>

  <div class="bloom-page">
    <div class="bloom-wash" aria-hidden="true"></div>

    <%- include('partials/nav-admin', { active: 'login' }) %>

    <main class="bloom-stage">
      <div class="bloom-card">
        <h1 class="bloom-title">Enter</h1>
        <p class="bloom-subtext">Not registered yet? <a href="/admin/signup">Signup</a></p>

        <form id="loginForm" action="/admin/login" method="POST">
          <div class="bloom-field">
            <label for="brandName">Brand name *</label>
            <input type="text" name="memberNick" id="brandName" placeholder="Username" required />
          </div>

          <div class="bloom-field">
            <label for="password">Password *</label>
            <input type="password" name="memberPassword" id="password" placeholder="Password" required />
          </div>

          <% if (typeof error !== 'undefined' && error) { %>
            <p class="bloom-error"><%= error %></p>
          <% } else { %>
            <p class="bloom-error" id="errorMsg"></p>
          <% } %>

          <button type="submit" class="bloom-submit">Login</button>
        </form>
      </div>
    </main>

    <footer class="bloom-footer">
      <span></span>
    </footer>
  </div>

  <script src="/js/login.js"></script>
</body>
</html>

  
 
