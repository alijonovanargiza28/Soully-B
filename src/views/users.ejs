<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', { title: 'Users', cssFile: 'users.css' }) %>
</head>
<body>

  <div class="bloom-page">
    <div class="bloom-wash" aria-hidden="true"></div>

    <%- include('partials/nav-admin', { active: 'users' }) %>

    <main class="bloom-stage">
      <h1 class="bloom-title">All Users List</h1>

      <div class="bloom-table-wrap">
        <table>
          <thead>
            <tr>
              <th>No</th>
              <th>Name</th>
              <th>Phone</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            <% users.forEach(function(u, i) { %>
            <tr>
              <td><%= i + 1 %></td>
              <td><%= u.name %></td>
              <td><%= u.phone %></td>
              <td>
                <select class="bloom-select <%= u.status === 'ACTIVE' ? 'active' : '' %>">
                  <option <%= u.status === 'ACTIVE' ? 'selected' : '' %>>ACTIVE</option>
                  <option <%= u.status === 'BLOCKED' ? 'selected' : '' %>>BLOCKED</option>
                </select>
              </td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>

      <div class="bloom-floral-footer">
      </div>
    </main>
  </div>

  <script src="/js/users.js"></script>
</body>
</html>
