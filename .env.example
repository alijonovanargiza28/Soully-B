MONGO_URL=mongodb://127.0.0.1:27017/soully
PORT=3003
SESSION_SECRET=replace-with-a-random-session-secret
SECRET_TOKEN=replace-with-a-random-jwt-secret
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
# Set TRUST_PROXY=1 only behind a trusted HTTPS reverse proxy.

COOKIE_SAME_SITE=lax
# Production: NODE_ENV=production, CORS_ORIGIN=https://your-domain
# Use two different random secrets (minimum 32 characters).
# Set an absolute persistent UPLOAD_ROOT; Docker supplies /app/uploads.
